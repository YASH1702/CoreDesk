datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  image         String?
  role          String    @default("CUSTOMER")
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id])
  staffProfile  Staff?
  appointments  Appointment[] @relation("UserAppointments")
  invoices      Invoice[]
  reviews       Review[]
  notifications Notification[]
  blogs         Blog[]
}

model Business {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  industry      String       @default("CONSULTING")
  logo          String?
  description   String?
  phone         String?
  email         String?
  address       String?
  currency      String       @default("USD")
  timezone      String       @default("UTC")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users         User[]
  services      Service[]
  staff         Staff[]
  appointments  Appointment[]
  customers     Customer[]
  leads         Lead[]
  gallery       Gallery[]
  testimonials  Testimonial[]
  faqs          FAQ[]
  blogs         Blog[]
  cmsSettings   Settings?
}

model Service {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String
  description  String
  category     String
  duration     Int
  price        Float
  bufferTime   Int      @default(0)
  image        String?
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffServices StaffService[]
  appointments  Appointment[]
}

model Staff {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bio          String?
  title        String?
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  services     StaffService[]
  availability Availability[]
  appointments Appointment[] @relation("StaffAppointments")
  leaves       StaffLeave[]
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model Availability {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isWorking Boolean  @default(true)
}

model StaffLeave {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  reason     String?
  isApproved Boolean  @default(false)
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  notes      String?
  createdAt  DateTime @default(now())

  appointments Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  staffId     String
  staff       Staff    @relation("StaffAppointments", fields: [staffId], references: [id])
  userId      String?
  user        User?    @relation("UserAppointments", fields: [userId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  
  startTime   DateTime
  endTime     DateTime
  status      String   @default("PENDING")
  notes       String?
  
  payment     Payment?
  invoice     Invoice?
  review      Review?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id             String      @id @default(cuid())
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String      @default("USD")
  status         String      @default("UNPAID")
  stripeIntentId String?
  paymentMethod  String?
  createdAt      DateTime    @default(now())
}

model Invoice {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  invoiceNumber String      @unique
  amount        Float
  tax           Float       @default(0)
  total         Float
  pdfUrl        String?
  createdAt     DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Review {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
}

model Blog {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  email      String
  phone      String?
  message    String
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
}

model Settings {
  id             String   @id @default(cuid())
  businessId     String   @unique
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  heroTitle      String?
  heroSubtitle   String?
  primaryColor   String   @default("#3B82F6")
  aboutText      String?
  seoTitle       String?
  seoDescription String?
}

model Gallery {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  imageUrl   String
  caption    String?
  category   String?
}

model Testimonial {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  role       String?
  company    String?
  content    String
  avatar     String?
  rating     Int      @default(5)
}

model FAQ {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  question   String
  answer     String
  order      Int      @default(0)
}
